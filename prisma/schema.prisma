// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MEMBER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum IncomeType {
  FIXED
  VARIABLE
}

enum IncomeStatus {
  EXPECTED
  RECEIVED
}

enum PaymentMethod {
  DEBIT
  CREDIT
  PIX
  CASH
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

enum Frequency {
  MONTHLY
  WEEKLY
  YEARLY
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  members    FamilyMember[]
  categories Category[]
  incomes    Income[]
  expenses   Expense[]
  cards      CreditCard[]
  invoices   Invoice[]
  bills      Bill[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  profileId String?
  profile   FamilyMember? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  sessions        Session[]
  createdExpenses Expense[] @relation("CreatedExpenses")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AppSession")
}

model FamilyMember {
  id        String   @id @default(cuid())
  name      String
  label     String?
  color     String   @default("#047857")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  users    User[]
  incomes  Income[]
  expenses Expense[]
  bills    Bill[]
  cards    CreditCard[]

  @@unique([familyId, name])
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  color     String
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  incomes  Income[]
  expenses Expense[]
  bills    Bill[]

  @@unique([familyId, name, type])
}

model Income {
  id          String       @id @default(cuid())
  description String
  value       Decimal      @db.Decimal(12, 2)
  type        IncomeType
  receivedAt  DateTime
  recurring   Boolean      @default(true)
  status      IncomeStatus @default(EXPECTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  responsibleId String
  responsible   FamilyMember @relation(fields: [responsibleId], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model CreditCard {
  id              String   @id @default(cuid())
  name            String
  bank            String
  limitTotal      Decimal  @db.Decimal(12, 2)
  dueDay          Int
  bestPurchaseDay Int
  closingDay      Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  ownerId String
  owner   FamilyMember @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  invoices Invoice[]
  expenses Expense[]

  @@unique([familyId, name])
}

model Invoice {
  id             String        @id @default(cuid())
  referenceMonth DateTime
  closingDate    DateTime
  dueDate        DateTime
  totalValue     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([cardId, referenceMonth])
}

model Expense {
  id                String        @id @default(cuid())
  description       String
  value             Decimal       @db.Decimal(12, 2)
  spentAt           DateTime
  paymentMethod     PaymentMethod
  shared            Boolean       @default(false)
  notes             String?
  installmentsCount Int           @default(1)
  installmentNumber Int           @default(1)
  installmentGroupId String?
  status            ExpenseStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  responsibleId String
  responsible   FamilyMember @relation(fields: [responsibleId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)

  cardId String?
  card   CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Bill {
  id          String     @id @default(cuid())
  name        String
  value       Decimal    @db.Decimal(12, 2)
  dueDate     DateTime
  recurring   Boolean    @default(false)
  frequency   Frequency?
  status      BillStatus @default(PENDING)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  responsibleId String
  responsible   FamilyMember @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
}
